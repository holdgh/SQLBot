2026-10-15 13:56:08,117 - apps.chat.task.llm - INFO:1734 - sql: SELECT
  `base_year` AS `基准年份`,
  `total_2024` AS `2024年港澳台游客总量`,
  `curr_year` AS `2025年港澳台游客总量`,
  `同比变化率` AS `同比变化率`
FROM (
  SELECT '2024' AS `base_year`, SUM(`t`.`游客数量`) AS `total_2024`
  FROM `wenlv_tong_test`.`上海市境外来源游客数量` `t`
  WHERE `t`.`景区所属行政区域` = '上海市'
    AND `t`.`境外来源地区` IN ('香港(中国)', '澳门(中国)', '台湾(中国)')
    AND `t`.`统计日期` BETWEEN '2024-01-01' AND '2024-12-31'
  GROUP BY `base_year`
  LIMIT 1000
) AS `base`
JOIN (
  SELECT '2025' AS `curr_year`, SUM(`t`.`游客数量`) AS `total_2025`
  FROM `wenlv_tong_test`.`上海市境外来源游客数量` `t`
  WHERE `t`.`景区所属行政区域` = '上海市'
    AND `t`.`境外来源地区` IN ('香港(中国)', '澳门(中国)', '台湾(中国)')
    AND `t`.`统计日期` BETWEEN '2025-01-01' AND '2025-12-31'
  GROUP BY `curr_year`
  LIMIT 1000
) AS `curr`
ON `base`.`base_year` = '2024' AND `curr`.`curr_year` = '2025'
UNION ALL
SELECT
  `base_year` AS `base_year`,
  `total_2024` AS `2024年港澳台游客总量`,
  `curr_year` AS `2025年港澳台游客总量`,
  CASE
    WHEN `base`.`total_2024` IS NOT NULL
      THEN CONCAT(ROUND((`curr`.`total_2025` - `base`.`total_2024`) * 100.0 / `base`.`total_2024`, 2), '%')
    ELSE NULL
  END AS `同比变化率`
FROM (
  SELECT '2024' AS `base_year`, SUM(`t`.`游客数量`) AS `total_2024`
  FROM `wenlv_tong_test`.`上海市境外来源游客数量` `t`
  WHERE `t`.`景区所属行政区域` = '上海市'
    AND `t`.`境外来源地区` IN ('香港(中国)', '澳门(中国)', '台湾(中国)')
    AND `t`.`统计日期` BETWEEN '2024-01-01' AND '2024-12-31'
  GROUP BY `base_year`
  LIMIT 1000
) AS `base`
CROSS JOIN (
  SELECT '2025' AS `curr_year`, SUM(`t`.`游客数量`) AS `total_2025`
  FROM `wenlv_tong_test`.`上海市境外来源游客数量` `t`
  WHERE `t`.`景区所属行政区域` = '上海市'
    AND `t`.`境外来源地区` IN ('香港(中国)', '澳门(中国)', '台湾(中国)')
    AND `t`.`统计日期` BETWEEN '2025-01-01' AND '2025-12-31'
  GROUP BY `curr_year`
  LIMIT 1000
) AS `curr`
WHERE `base_year` = '2024' AND `curr_year` = '2025'
ORDER BY `base_year`;
