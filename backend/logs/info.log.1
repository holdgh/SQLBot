     SUM(CASE WHEN `统计日期` BETWEEN '2024-01-01' AND '2024-12-31' THEN `游客数量` ELSE 0 END), 2), '%') AS `同比变化率`
FROM `上海市境外来源游客数量`
WHERE `景区所属行政区域` = '上海市'
AND `境外来源地区` IN ('香港(中国)', '澳门(中国)', '台湾(中国)')
LIMIT 1000
